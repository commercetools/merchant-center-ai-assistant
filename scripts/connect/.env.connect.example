# Deployment inputs for scripts/connect/connect.mjs. Copy to scripts/connect/.env.connect (git-ignored)
# and fill in. Real environment variables win over this file. Never commit the filled-in copy.

# Connect region of the deployment and the project you deploy INTO
CONNECT_REGION=us-central1.gcp
CTP_PROJECT_KEY=
# API client for the read-only Connect REST helper; the same client as the CLI login
CONNECT_CLIENT_ID=
CONNECT_CLIENT_SECRET=
# Connector registration (stage / publish / update-code)
CONNECTOR_KEY=ai-assistant
CONNECTOR_NAME=AI Assistant
CREATOR_EMAIL=
REPO_URL=
REPO_TAG=
# Deployment (sandbox is the default; production needs --confirm-production)
DEPLOYMENT_KEY=ai-assistant-sandbox
DEPLOYMENT_TYPE=sandbox
# Ids and paths you recorded when registering the Custom Applications and the Custom View
MC_APP_CUSTOM_APPLICATION_ID=
MC_APP_ENTRY_POINT_URI_PATH=ai-assistant
COMPOSED_APPS_CUSTOM_APPLICATION_ID=
COMPOSED_APPS_ENTRY_POINT_URI_PATH=ai-assistant-pages
MC_VIEW_CUSTOM_VIEW_ID=
# Service secrets (secured configuration). GCP_SA_KEY_BASE64 is the Base64 of the whole JSON key on ONE line:
#   base64 < key.json | tr -d '\n'
# ENCRYPTION_KEY is a Base64 32-byte key: openssl rand -base64 32
GCP_SA_KEY_BASE64=
ENCRYPTION_KEY=
# Optional administrator allowlist: comma-separated Merchant Center USER IDS of administrators
# (find yours in the app: Settings > About > Your user ID). Empty = nobody is an administrator.
ADMIN_USER_IDS=
# Optional Google Cloud settings; empty = the service default applies
GCP_PROJECT_ID=
GCP_VERTEX_LOCATION=
GCP_BIGQUERY_DATASET_ID=
GCP_BIGQUERY_LOCATION=
GCP_BUCKET_LOCATION=
IMAGE_URL_MODE=
GCP_BUCKET_NAME=
# Optional third-party providers; leave empty to keep a provider disabled
CONTENTSTACK_API_KEY=
CONTENTSTACK_MANAGEMENT_TOKEN=
CONTENTSTACK_BRANCH=
CONTENTSTACK_REGION=na
ALGOLIA_MCP_URL=
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=
