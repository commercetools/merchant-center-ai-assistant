{
  "extends": "@commercetools-frontend/application-config/tsconfig-mc-app.json",
  "compilerOptions": {
    "typeRoots": ["@types", "@types-extensions", "node_modules/@types"],
    // Chakra's generated `recipes.gen.d.ts` / `system.gen.d.ts` (produced from the
    // Nimbus theme) contain duplicate identifiers and reference CSS properties this
    // Chakra version does not declare. They are regenerated on every install, so the
    // only way to keep `tsc` usable is to not type-check dependency declarations.
    "skipLibCheck": true,
    // Allow tsc to resolve dependencies of `@types` packages in the way pnpm sets up the `node_modules`.
    "preserveSymlinks": false
  },
  "include": ["src"]
}
