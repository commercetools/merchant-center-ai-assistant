# Local development only. Connect injects the deployed values from connect.yaml.
ENABLE_NEW_JSX_TRANSFORM="true"
FAST_REFRESH="true"
APPLICATION_URL=https://example.invalid
# Your commercetools project key (required for yarn start).
INITIAL_PROJECT_KEY=
CUSTOM_VIEW_ID=replace-with-registered-custom-view-id
CLOUD_IDENTIFIER=gcp-us
CHAT_SERVICE_ENDPOINT_URL=https://example.invalid/service
# Dev host page for yarn start, for example /<your-project-key>/categories (required for yarn start).
HOST_URI_PATH=
