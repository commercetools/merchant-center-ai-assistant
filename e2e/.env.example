# Copy to e2e/.env.e2e (git-ignored) and fill in the values for your scratch project.
# Obviously fake or empty values only: never commit real project keys, URLs or user ids.
# local | sandbox
E2E_ENV=local
# The scratch commercetools project key (empty here on purpose).
E2E_PROJECT_KEY=
# Merchant Center host for the project region, for example the GCP US central host. Empty here.
E2E_MC_HOST=
E2E_REGION=gcp-us
# Service origin (no trailing slash and no /service suffix): the tunnel URL locally, the Connect URL on sandbox.
SERVICE_URL=
# Merchant Center URLs of the three apps: <MC host>/<project key>/<entry point URI path> (the apps run inside
# Merchant Center; locally the registered development URL points at the dev server, on sandbox at the deployment).
APP_URL=
PAGES_URL=
VIEW_URL=
# A product page of the scratch project that hosts the mc-view-app panel (change S).
HOST_PAGE_URL=
# Destructive scenarios (restart, undeploy) run only when this is 1.
E2E_ALLOW_DESTRUCTIVE=0
# Cost cap: maximum chat turns in one run.
E2E_MAX_TURNS=60
# 1 when the non-admin user's Chrome on port 9223 is logged in (manual step M10).
E2E_SECOND_USER=0
E2E_ADMIN_BROWSER_URL=http://127.0.0.1:9222
E2E_NONADMIN_BROWSER_URL=http://127.0.0.1:9223
# Tunnel tool for local runs: cloudflared or any tool that prints a public https URL.
E2E_TUNNEL=cloudflared
# Projects that must never be tested (comma separated keys, checked by the preflight).
E2E_PROJECT_DENYLIST=
