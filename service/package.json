{
  "name": "@commercetools-labs/ai-assistant-service",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "rimraf ./build && tsc -p tsconfig.build.json",
    "gcp-build": "npm run build",
    "start": "node build/index.js",
    "start:dev": "tsx watch --env-file=.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "connector:post-deploy": "node build/connector/post-deploy.js",
    "connector:pre-undeploy": "node build/connector/pre-undeploy.js",
    "persistence:reencrypt": "node --env-file=.env.local scripts/reencrypt.mjs",
    "generate:nimbus-surface": "node scripts/generate-nimbus-surface.mjs",
    "check:nimbus-surface": "node scripts/generate-nimbus-surface.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "^5.0.109",
    "@ai-sdk/mcp": "^2.0.73",
    "@ai-sdk/provider-utils": "^5.0.58",
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.9",
    "@babel/preset-react": "7.29.7",
    "@babel/traverse": "7.29.10",
    "@commercetools-backend/express": "^27.13.0",
    "@commercetools-backend/loggers": "^27.13.0",
    "@commercetools/nimbus-mcp": "3.6.0",
    "@commercetools/platform-sdk": "^8.27.0",
    "@commercetools/ts-client": "^4.10.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/storage": "^7.22.0",
    "@google/genai": "^1.52.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@stripe/agent-toolkit": "0.7.12",
    "ai": "7.0.136",
    "body-parser": "^1.20.9",
    "express": "^4.22.3",
    "google-auth-library": "^10.9.1",
    "sharp": "^0.35.5",
    "graphql": "17.0.2",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.26",
    "@jest/globals": "^30.5.2",
    "@tsconfig/recommended": "^1.0.13",
    "@types/babel__core": "7.20.5",
    "@types/babel__traverse": "7.28.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "jose": "^5.10.0",
    "msw": "^3.0.2",
    "prettier": "^3.9.9",
    "rimraf": "^5.0.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "overrides": {
    "@stripe/agent-toolkit": {
      "ai": "$ai",
      "zod": "$zod"
    },
    "openai": {
      "zod": "$zod"
    },
    "@langchain/core": {
      "uuid": "11.1.1",
      "zod": "$zod"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    },
    "langsmith": "^0.6.0"
  }
}
