# Local development: copy to .env.local (git-ignored) and run `npm run start:dev`.
# Blank means unset. Secrets are never committed; deployed values come from Connect configuration.

# --- server
# development | test | production (Connect does not set it; unset means production)
NODE_ENV=development
# Listening port (default 8080)
PORT=8080
# error | warn | info | debug | verbose
LOG_LEVEL=info
# Chat time budget (ms). Connect times a request out after 5 minutes: budget <= 285000.
CHAT_REQUEST_BUDGET_MS=270000
CHAT_FINALIZE_RESERVE_MS=30000
# Kill switch of the embedded Nimbus documentation tools (true | false, default true)
NIMBUS_MCP_ENABLED=true
# true logs one line per request (never bodies or credentials)
LOG_HTTP=false

# --- commercetools (injected by Connect through inheritAs.apiClient; set by hand locally)
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_SCOPE=
CTP_API_URL=
CTP_AUTH_URL=
# API region, for example us-central1.gcp (a connect.yaml standard configuration key)
CTP_REGION=

# --- cache
CACHE_MAX_ENTRIES=5000
CACHE_SWEEP_MS=60000
MCP_TOOLS_TTL_MS=
MCP_HANDSHAKE_TIMEOUT_MS=10000
CHAT_DIGEST_BEFORE_CLOSE=false

# --- auth (change D)
# LOCAL DEVELOPMENT ONLY. The service takes the audience of the Merchant Center token and the
# Managed MCP OAuth callback from the origin of its own public URL, CONNECT_SERVICE_URL. Connect
# provides it in a deployment, so never set it there. Locally set the SERVICE's URL, not the
# frontend's: http://localhost:8080/service (http is accepted only outside production).
# Empty rejects all Merchant Center traffic.
CONNECT_SERVICE_URL=
# Local development bypass; refused when NODE_ENV=production. Also allows the http OAuth
# callback above and CORS from localhost, so a frontend on `yarn start` can call the service.
MC_AUTH_DISABLED=
MC_APP_ENTRY_POINT_URI_PATH=
# Comma-separated Merchant Center user ids (at most 50) of administrators; empty means nobody
ADMIN_USER_IDS=
# Feature flag (true | false, default false): when true every verified user, not only an
# administrator, may create, change and delete the shared Managed MCP binding
MCP_BINDING_OPEN_TO_ALL=

# --- persistence (change E)
# custom-objects (default) | memory (never in production)
PERSISTENCE_DRIVER=
PERSISTENCE_CONCURRENCY=
# Settings cache lifetime in ms (0 disables, default 5000)
SETTINGS_CACHE_TTL_MS=
# Base64 of a 32-byte key (openssl rand -base64 32); required
ENCRYPTION_KEY=
# Comma-separated retired keys (decrypt only)
ENCRYPTION_KEY_PREVIOUS=

# --- Google Cloud (change F)
# Base64 of the whole service-account JSON key (one line):
#   base64 < key.json | tr -d '\n'
# It serves Vertex AI (Gemini text and image), BigQuery and Cloud Storage. Required in production.
GCP_SA_KEY_BASE64=
GCP_PROJECT_ID=
# global, us, eu or a region. The default gemini-3.8-flash is not served from every region:
# use global if Vertex answers "Publisher model ... was not found".
GCP_VERTEX_LOCATION=us-central1
GCP_BIGQUERY_DATASET_ID=aiassistant
GCP_BIGQUERY_LOCATION=us-central1
GCP_BUCKET_NAME=
GCP_BUCKET_LOCATION=us-central1
# private | public
IMAGE_URL_MODE=private
GEMINI_MODEL_NAME=
GEMINI_AGENT_MODEL_NAME=
GEMINI_LITE_MODEL_NAME=
GEMINI_IMAGE_MODEL_NAME=
# minimal | low | medium | high
GEMINI_LITE_THINKING_LEVEL=minimal

# --- optional providers (change J); a provider is enabled only when all its keys are set
CONTENTSTACK_API_KEY=
CONTENTSTACK_MANAGEMENT_TOKEN=
CONTENTSTACK_BRANCH=
# na | eu | au | azure-na | azure-eu | gcp-na | gcp-eu
CONTENTSTACK_REGION=na
# URL of the Algolia MCP server (may embed a key)
ALGOLIA_MCP_URL=
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=
